# RabbitMQ Configuration
# Copy this file to config.py and fill in your actual values

import os

RABBITMQ_HOST = 'localhost'
RABBITMQ_PORT = 5672
RABBITMQ_USER = 'guest'
RABBITMQ_PASS = 'guest'


# Modo de documento: RESERVA, ya no interruptor.
#
# La decision de que hacer con el documento contable la toma ahora el productor
# y viaja en el mensaje, en `parameters.document_mode` (ver document_mode.py y
# `sical-robot/docs/document-robot-split-spec.md`, §4). CONTABLE_CAPTURE_ENABLED
# solo se consulta cuando el mensaje NO trae el campo -consumidor nuevo contra
# productor viejo-, que es lo que permite desplegar el productor primero. Se
# retira cuando los tres consumidores entiendan el campo.
def _as_bool(value, default=False):
    if value is None:
        return default
    return str(value).strip().lower() in ('1', 'true', 'yes', 'on')


CONTABLE_CAPTURE_ENABLED = _as_bool(
    os.getenv('CONTABLE_CAPTURE_ENABLED', 'false'), False)
SICAL_PDF_WORKDIR = os.getenv(
    'SICAL_PDF_WORKDIR',
    os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data', 'doc_work'),
)
MAX_INLINE_BYTES = int(os.getenv('MAX_INLINE_BYTES', 2 * 1024 * 1024))
